# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/aurapath?schema=public"

# Auth.js (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-character-secret-key-goes-here-replace-in-prod"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# S3 Private Bucket for Report PDFs
S3_REGION="us-east-1"
S3_BUCKET_NAME="aurapath-private-reports"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_ENDPOINT=""

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="AuraPath <noreply@aurapath.com>"

# SMS Gateway for Phone OTP (stub / twilio / msg91)
SMS_PROVIDER="stub"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Backend API Service
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/aurapath?schema=public"


# Auth.js (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-character-secret-key-goes-here-replace-in-prod"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Cloudflare R2 Storage (Reports & Avatars)
S3_REGION="auto"
S3_BUCKET_NAME="alderwood-storage"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_ENDPOINT="https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="alderwood-storage"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Alderwood Vantage <support@mail.alderwoodvantage.com>"
EMAIL_REPLY_TO="support@alderwoodvantage.com"
CONTACT_NOTIFICATION_EMAIL="support@alderwoodvantage.com"
INSTITUTIONAL_NOTIFICATION_EMAIL="partnerships@alderwoodvantage.com"

# SMS Gateway for Phone OTP (stub / twilio / msg91)
SMS_PROVIDER="stub"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
